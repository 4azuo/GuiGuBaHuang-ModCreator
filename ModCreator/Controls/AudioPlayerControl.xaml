<UserControl x:Class="ModCreator.Controls.AudioPlayerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="400"
             x:Name="root">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <MediaElement x:Name="audioPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" 
                      MediaOpened="AudioPlayer_MediaOpened"
                      MediaEnded="AudioPlayer_MediaEnded"
                      Width="0" Height="0"/>
        <TextBlock Text="🔊 Audio File" FontSize="24" Foreground="{Binding ElementName=root, Path=IconColor}" Margin="0,0,0,20"/>
        <TextBlock x:Name="txtFileName" FontSize="14" Foreground="{Binding ElementName=root, Path=IconColor}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="btnPlayAudio" Content="▶ Play" Click="PlayAudio_Click" Width="80" Height="32" Margin="5"/>
            <Button x:Name="btnPauseAudio" Content="⏸ Pause" Click="PauseAudio_Click" Width="80" Height="32" Margin="5" IsEnabled="False"/>
            <Button x:Name="btnStopAudio" Content="⏹ Stop" Click="StopAudio_Click" Width="80" Height="32" Margin="5" IsEnabled="False"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <TextBlock x:Name="txtCurrentTime" Text="00:00" VerticalAlignment="Center" Margin="5,0"/>
            <Slider x:Name="audioSeekBar" Width="300" Minimum="0" Maximum="100" Value="0" 
                    ValueChanged="AudioSeekBar_ValueChanged" 
                    PreviewMouseDown="AudioSeekBar_PreviewMouseDown"
                    PreviewMouseUp="AudioSeekBar_PreviewMouseUp"
                    VerticalAlignment="Center" Margin="5,0"/>
            <TextBlock x:Name="txtTotalTime" Text="00:00" VerticalAlignment="Center" Margin="5,0"/>
        </StackPanel>
    </StackPanel>
</UserControl>
