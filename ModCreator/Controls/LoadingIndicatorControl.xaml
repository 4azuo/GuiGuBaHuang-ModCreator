<UserControl x:Class="ModCreator.Controls.LoadingIndicatorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="⏳" FontSize="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                   HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock.RenderTransform>
                <RotateTransform x:Name="LoadingRotation" CenterX="{Binding HalfIconSize, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                 CenterY="{Binding HalfIconSize, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </TextBlock.RenderTransform>
            <TextBlock.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="LoadingRotation"
                                           Storyboard.TargetProperty="Angle"
                                           From="0" To="360" Duration="0:0:2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </TextBlock.Triggers>
        </TextBlock>
        <TextBlock Text="{Binding LoadingText, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                   FontSize="14" Foreground="Gray" HorizontalAlignment="Center"/>
    </StackPanel>
</UserControl>
