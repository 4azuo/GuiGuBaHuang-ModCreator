<local:CWindow x:Class="ModCreator.Windows.PatternRefDocsWindow" x:TypeArguments="localData:PatternRefDocsWindowData"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ModCreator.Windows"
        xmlns:localData="clr-namespace:ModCreator.WindowData"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        mc:Ignorable="d"
        Title="Reference Documentation" Height="700" Width="900" WindowStartupLocation="CenterOwner"
        Icon="/Resources/app-icon.png" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#FF2E5090" Padding="15">
            <StackPanel>
                <TextBlock Text="Reference Documentation" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="{Binding FileName, Mode=OneWay}" FontSize="12" Foreground="#FFCCCCCC" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Search Panel -->
        <Border Grid.Row="1" Background="#FFF5F5F5" BorderBrush="#FFCCCCCC" BorderThickness="0,1" Padding="10,5" x:Name="searchPanel" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Find:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" x:Name="txtSearchBox" MinWidth="200" Padding="5,3" 
                         KeyDown="TxtSearchBox_KeyDown"/>
                <Button Grid.Column="2" Content="↓ Next" Click="FindNext_Click" 
                        Style="{StaticResource ActionButton}" Width="70" Margin="5,0,0,0"/>
                <Button Grid.Column="3" Content="↑ Previous" Click="FindPrevious_Click" 
                        Style="{StaticResource ActionButton}" Width="80" Margin="5,0,0,0"/>
                <CheckBox Grid.Column="4" Content="Match Case" x:Name="chkMatchCase" 
                          VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Button Grid.Column="5" Content="✕" Click="CloseSearch_Click" 
                        Width="25" Height="25" Margin="10,0,0,0" 
                        Background="Transparent" BorderThickness="0" FontSize="14" FontWeight="Bold"/>
            </Grid>
        </Border>

        <!-- Content Editor -->
        <avalonedit:TextEditor x:Name="txtEditor" Grid.Row="2" 
                               FontFamily="Consolas" FontSize="12" 
                               ShowLineNumbers="True" 
                               IsReadOnly="True"
                               VerticalScrollBarVisibility="Auto" 
                               HorizontalScrollBarVisibility="Auto"
                               Margin="10"/>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="Close" Click="Close_Click" Style="{StaticResource ActionButton}" Width="100"/>
        </StackPanel>
    </Grid>
</local:CWindow>
